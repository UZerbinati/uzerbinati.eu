---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign sitemap_pages = site.pages | sort: "url" -%}
{%- for p in sitemap_pages %}
{%- if p.layout == "home" or p.layout == "block" or p.layout == "page" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- if p.layout == "home" %}
    <priority>1.0</priority>
    {%- endif %}
  </url>
{%- endif -%}
{%- endfor %}
</urlset>
